{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@foldkit/oxlint-plugin/recommended.json"],
  // NOTE: the project's own rules (AGENTS.md "Code shape").
  "jsPlugins": ["./tools/lint/munchPlugin.ts"],
  // NOTE: naming plugins replaces oxlint's defaults, so the defaults are listed
  // here with vitest added, and import for import/no-cycle.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vitest", "import"],
  // NOTE: type-aware rules run through oxlint-tsgolint.
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "rules": {
    // NOTE: no module imports one that imports it back, type imports too
    // (AGENTS.md "Code shape").
    "import/no-cycle": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "sort-imports": [
      "error",
      { "ignoreDeclarationSort": true, "ignoreCase": false }
    ],
    "typescript/array-type": ["error", { "default": "generic" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "curly": ["error", "all"],
    "eqeqeq": ["error", "always"],
    "no-shadow": "error",
    "unicorn/require-post-message-target-origin": "error",
    // NOTE: a scene's tap step runs its expects, as do @effect/vitest's
    // it.effect and it.live, and vitest takes a message as expect's second
    // argument.
    "vitest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["tap", "it.effect", "it.live"] }
    ],
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // NOTE: story() and scene() assert through their steps.
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expect*",
          "vitestExpect",
          "story",
          "scene",
          "Story.story",
          "Scene.scene"
        ]
      }
    ],
    // NOTE: a file past 1200 lines holds two jobs: split it along its
    // section headers (AGENTS.md "Code shape").
    "max-lines": ["error", { "max": 1200 }],

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "munch/no-tag-chain": "error",
    "munch/no-extract-tag": "error",
    "munch/no-raw-json": "error",
    "munch/no-conditional-step": "error",
    "munch/no-world-spread": "error",
    "munch/tap-by-click": "error",
    "munch/live-test-note": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-base-to-string": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/strict-boolean-expressions": "error"
  },
  "overrides": [
    {
      // NOTE: the game's own rules (AGENTS.md "Rules"): update is pure and
      // deterministic, storage goes through the store, per-frame code checks
      // tags with isAnyOf, and overlays read the screen from screenOf(model).
      "files": ["src/**/*.ts"],
      "rules": {
        "no-console": "error",
        "munch/no-menu-field": "error",
        "munch/command-beside-update": "error",
        "munch/key-action-once": "error",
        "munch/no-binding-field-write": "error",
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "update is pure: draw from the seeded generator in the Model (src/prng.ts)."
          },
          {
            "object": "Date",
            "property": "now",
            "message": "update never reads the clock: time arrives in a Message."
          },
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "Ids come from the seeded generator, or from Effect's Crypto in a Command."
          },
          {
            "object": "performance",
            "property": "now",
            "message": "Frame time is read once, in src/subscriptions.ts."
          },
          {
            "object": "Data",
            "property": "taggedEnum",
            "message": "Use a Schema union (defineTaggedUnion) and its exhaustive match."
          },
          {
            "property": "guards",
            "message": "A guard validates the whole value through Schema. Check a tag with isAnyOf."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "localStorage",
            "message": "Persistent data goes through PlayerStore (src/store.ts)."
          },
          {
            "name": "sessionStorage",
            "message": "Persistent data goes through PlayerStore (src/store.ts)."
          },
          {
            "name": "indexedDB",
            "message": "Persistent data goes through PlayerStore (src/store.ts)."
          },
          {
            "name": "setTimeout",
            "message": "Wait with Effect.sleep or a Schedule in a Command or Subscription."
          },
          {
            "name": "setInterval",
            "message": "Tick with a Subscription and a Schedule."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/constants", "./constants"],
                "importNames": ["VIEW_WIDTH", "VIEW_HEIGHT"],
                "message": "Overlay code reads the screen from screenOf(model)."
              }
            ]
          }
        ]
      }
    },
    {
      // NOTE: a wrong non-null assertion in a test fails the test loudly, as
      // it should. test.todo marks a balance guardrail not met yet (AGENTS.md).
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "vitest/warn-todo": "off"
      }
    },
    {
      // NOTE: single player's handlers apply a player action as a seat
      // action (src/stepWorld.ts), the rule the co-op room runs, and never
      // decide one again (AGENTS.md "Code shape").
      "files": [
        "src/update/**/*.ts",
        "src/main.ts",
        "src/runFlow.ts",
        "src/couch.ts"
      ],
      "rules": { "munch/seat-action-once": "error" }
    },
    {
      // NOTE: tests and their fixtures may read guards, seed the legacy
      // localStorage save, check the view size itself, and look at a
      // dialog's own state.
      "files": [
        "src/**/*.test.ts",
        "src/**/*.fixture.ts",
        "src/testing.ts",
        "src/vitest-setup.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "munch/no-menu-field": "off",
        "munch/no-binding-field-write": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Tests replay seeds: use the seeded generator (src/prng.ts)."
          },
          {
            "object": "Date",
            "property": "now",
            "message": "Tests replay Messages: pass time in a Message."
          },
          {
            "object": "Data",
            "property": "taggedEnum",
            "message": "Use a Schema union (defineTaggedUnion) and its exhaustive match."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "Wait with Effect.sleep or a TestClock."
          },
          {
            "name": "setInterval",
            "message": "Tick with a Subscription and a Schedule."
          }
        ]
      }
    },
    {
      // NOTE: the frame clock is read here and nowhere else.
      "files": ["src/subscriptions.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "Math", "property": "random" },
          { "object": "Date", "property": "now" },
          { "object": "crypto", "property": "randomUUID" },
          { "object": "Data", "property": "taggedEnum" },
          { "property": "guards" }
        ]
      }
    },
    {
      // NOTE: the store is where storage lives: save.ts keeps the legacy
      // localStorage copy that store.ts falls back to.
      "files": [
        "src/save.ts",
        "src/store.ts",
        "src/storeSqlite.ts",
        "src/storeEarly.ts",
        "src/store.worker.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      // NOTE: the service worker runs outside the game and the Effect runtime.
      "files": ["src/sw/worker.ts"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      // NOTE: these define the view size (constants, screen), do world math
      // (camera, geometry), or draw deliberately inside inLandscapeFrame
      // (screens, endView, bossView).
      "files": [
        "src/constants.ts",
        "src/screen.ts",
        "src/camera.ts",
        "src/geometry.ts",
        "src/screens.ts",
        "src/endView.ts",
        "src/bossView.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // NOTE: tools and the build configs are host scripts, not Foldkit apps: the Foldkit rules do
      // not apply, and they wait on browsers and child processes one at a time.
      "files": ["tools/**/*.ts", "vite.config.ts", "vitest.config.ts"],
      "rules": {
        "foldkit/no-impure-call-at-decision-time": "off",
        "foldkit/no-module-level-mutable-state": "off",
        "foldkit/no-child-message-construction-in-root": "off",
        "foldkit/no-spread-in-modify-fields": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      // NOTE: the tools and the packages keep the game's bans that apply
      // outside update (AGENTS.md "Strictness"): time from Effect's Clock,
      // waits from Effect.sleep or a Schedule, requests through HttpClient,
      // and unions as Schema unions.
      "files": [
        "tools/**/*.ts",
        "packages/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Draw from a seeded generator, or Effect's Random."
          },
          {
            "object": "Date",
            "property": "now",
            "message": "Read the time from Effect's Clock (Clock.currentTimeMillis)."
          },
          {
            "object": "Data",
            "property": "taggedEnum",
            "message": "Use a Schema union (Schema.TaggedUnion) and its exhaustive match."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "Wait with Effect.sleep or a Schedule."
          },
          {
            "name": "setInterval",
            "message": "Repeat with a Schedule."
          },
          {
            "name": "fetch",
            "message": "Request through Effect's HttpClient."
          }
        ]
      }
    },
    {
      // NOTE: menuState derives which menu is up from these fields, so it is
      // the one place that reads them (munch/no-menu-field).
      "files": ["src/menuState.ts"],
      "rules": { "munch/no-menu-field": "off" }
    },
    {
      // NOTE: the one key table, the one place that asks whether READY's
      // key is held to buy (munch/key-action-once).
      "files": ["src/keyActions.ts"],
      "rules": { "munch/key-action-once": "off" }
    },
    {
      // NOTE: tests and their shared setup run Effects with it.effect from
      // @effect/vitest, never by hand (munch/no-run-in-tests).
      "files": [
        "**/*.test.ts",
        "**/test/**/*.ts",
        "**/*.fixture.ts",
        "**/*.setup.ts",
        "**/{testing,Testing,roomTesting}.ts",
        "src/vitest-setup.ts",
        "src/testPng.ts"
      ],
      "rules": { "munch/no-run-in-tests": "error" }
    },
    // NOTE: the files allowed raw JSON.parse and JSON.stringify, each with
    // its reason. Everything else reads and writes JSON through a Schema.
    {
      // NOTE: tests write raw and malformed payloads to feed the decoders,
      // and compare plain values by their text.
      "files": ["**/*.test.ts"],
      "rules": { "munch/no-raw-json": "off" }
    },
    {
      // NOTE: writes the service worker's build id and precache list as
      // JavaScript literals into its source, not JSON to be read back.
      "files": ["src/sw/precache.ts"],
      "rules": { "munch/no-raw-json": "off" }
    },
    {
      // NOTE: the two scripts that cannot split by moving code: each keeps a
      // run's state in module-level `let`s that its sections assign, and an
      // import is read-only, so a split needs that state passed in first.
      "files": ["tools/audit/harness/entry.ts", "tools/balance/bot.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "repos/",
    "**/*.d.ts",
    "**/*.config.js",
    "**/*.config.mjs"
  ]
}
