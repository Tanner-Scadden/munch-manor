{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // NOTE: the project's own rules (AGENTS.md "Code shape").
  "jsPlugins": ["./tools/lint/munchPlugin.ts"],
  // NOTE: naming plugins replaces oxlint's defaults, so the defaults are listed
  // here with vitest added, and import for import/no-cycle.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vitest", "import"],
  // NOTE: type-aware rules run through oxlint-tsgolint.
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "rules": {
    // NOTE: no module imports one that imports it back, type imports too
    // (AGENTS.md "Code shape").
    "import/no-cycle": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "sort-imports": [
      "error",
      { "ignoreDeclarationSort": true, "ignoreCase": false }
    ],
    "typescript/array-type": ["error", { "default": "generic" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "curly": ["error", "all"],
    "eqeqeq": ["error", "always"],
    "no-shadow": "error",
    "unicorn/require-post-message-target-origin": "error",
    // NOTE: an Effect generator may yield nothing (a Command's body, a
    // Layer's build), as Effect's own docs write them.
    "require-yield": "off",
    // NOTE: @effect/vitest's it.effect, it.effect.each, and it.live run
    // their expects, and vitest takes a message as expect's second argument.
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": [
          "it.effect",
          "it.effect.each",
          "it.live"
        ]
      }
    ],
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // NOTE: a Story, Scene, or Play asserts through its steps, and its end
    // check fails on anything left pending (Effect UI's testing guide).
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expect*",
          "vitestExpect",
          "assert",
          "assert.*",
          "Story.make",
          "Scene.make",
          "HtmlScene.make",
          "HtmlPlay.make"
        ]
      }
    ],
    // NOTE: a file past 1200 lines holds two jobs: split it along its
    // section headers (AGENTS.md "Code shape").
    "max-lines": ["error", { "max": 1200 }],

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "munch/no-tag-chain": "error",
    "munch/no-extract-tag": "error",
    "munch/no-raw-json": "error",
    "munch/no-conditional-step": "error",
    "munch/no-world-spread": "error",
    "munch/tap-by-click": "error",
    "munch/no-comments": "error",
    // NOTE: a reduce that copies its accumulator list each step is
    // quadratic (AGENTS.md "Code shape").
    "munch/no-append-in-reduce": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-base-to-string": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/strict-boolean-expressions": "error"
  },
  "overrides": [
    {
      // NOTE: the game's own rules (AGENTS.md "Rules"): update is pure and
      // deterministic, storage goes through the store, per-frame code checks
      // tags with isAnyOf, and overlays read the screen from screenOf(model).
      "files": ["src/**/*.ts"],
      "rules": {
        "no-console": "error",
        "munch/no-menu-field": "error",
        "munch/command-beside-update": "error",
        "munch/key-action-once": "error",
        "munch/stand-through-space": "error",
        "munch/no-dialog-field-write": "error",
        "munch/folder-imports": "error",
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "update is pure: draw from the seeded generator in the Model (src/shared/prng.ts)."
          },
          {
            "object": "Date",
            "property": "now",
            "message": "update never reads the clock: time arrives in a Message."
          },
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "Ids come from the seeded generator, or from Effect's Crypto in a Command."
          },
          {
            "object": "performance",
            "property": "now",
            "message": "Frame time is read once, in src/app/subscriptions.ts."
          },
          {
            "object": "Data",
            "property": "taggedEnum",
            "message": "Use a Schema union (defineTaggedUnion) and its exhaustive match."
          },
          {
            "property": "guards",
            "message": "A guard validates the whole value through Schema. Check a tag with isAnyOf."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "localStorage",
            "message": "Persistent data goes through PlayerStore (src/platform/store.ts)."
          },
          {
            "name": "sessionStorage",
            "message": "Persistent data goes through PlayerStore (src/platform/store.ts)."
          },
          {
            "name": "indexedDB",
            "message": "Persistent data goes through PlayerStore (src/platform/store.ts)."
          },
          {
            "name": "setTimeout",
            "message": "Wait with Effect.sleep or a Schedule in a Command or Subscription."
          },
          {
            "name": "setInterval",
            "message": "Tick with a Subscription and a Schedule."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/constants", "./constants"],
                "importNames": ["VIEW_WIDTH", "VIEW_HEIGHT"],
                "message": "Overlay code reads the screen from screenOf(model)."
              }
            ]
          }
        ]
      }
    },
    {
      // NOTE: the 3D scene stands the tall furniture only through
      // furniture.ts, its own batch built once per level, never frame by frame.
      "files": ["src/render/iso/scene.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/constants", "./constants"],
                "importNames": ["VIEW_WIDTH", "VIEW_HEIGHT"],
                "message": "Overlay code reads the screen from screenOf(model)."
              },
              {
                "group": ["**/room/tallCover"],
                "importNames": ["tallCoverOf"],
                "message": "The scene stands the furniture only through furniture.ts."
              },
              {
                "group": ["**/depth"],
                "importNames": ["TALL_MOST"],
                "message": "The scene stands the furniture only through furniture.ts."
              }
            ]
          }
        ]
      }
    },
    {
      // NOTE: a wrong non-null assertion in a test fails the test loudly, as
      // it should. test.todo marks a balance guardrail not met yet (AGENTS.md).
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "vitest/warn-todo": "off"
      }
    },
    {
      // NOTE: single player's handlers apply a player action as a seat
      // action (src/world/step/stepWorld.ts), the rule the co-op room runs,
      // and never decide one again (AGENTS.md "Code shape"). The handlers'
      // Steps live in app/update and in each feature's update.ts.
      "files": [
        "src/app/update/*.ts",
        "src/features/*/update.ts",
        "src/app/main.ts",
        "src/app/runFlow.ts",
        "src/input/couch.ts"
      ],
      "rules": { "munch/seat-action-once": "error" }
    },
    {
      // NOTE: tests and their fixtures may read guards, seed the legacy
      // localStorage save, check the view size itself, and look at a
      // dialog's own state.
      "files": [
        "src/**/*.test.ts",
        "src/**/*.fixture.ts",
        "src/test/testing.ts",
        "src/test/vitest-setup.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "munch/no-menu-field": "off",
        "munch/no-dialog-field-write": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Tests replay seeds: use the seeded generator (src/shared/prng.ts)."
          },
          {
            "object": "Date",
            "property": "now",
            "message": "Tests replay Messages: pass time in a Message."
          },
          {
            "object": "Data",
            "property": "taggedEnum",
            "message": "Use a Schema union (defineTaggedUnion) and its exhaustive match."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "Wait with Effect.sleep or a TestClock."
          },
          {
            "name": "setInterval",
            "message": "Tick with a Subscription and a Schedule."
          }
        ]
      }
    },
    {
      // NOTE: the frame clock is read here and nowhere else.
      "files": ["src/app/subscriptions.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "object": "Math", "property": "random" },
          { "object": "Date", "property": "now" },
          { "object": "crypto", "property": "randomUUID" },
          { "object": "Data", "property": "taggedEnum" },
          { "property": "guards" }
        ]
      }
    },
    {
      // NOTE: the store is where storage lives: save.ts keeps the legacy
      // localStorage copy that store.ts falls back to.
      "files": [
        "src/platform/save.ts",
        "src/platform/store.ts",
        "src/platform/storeSqlite.ts",
        "src/platform/storeEarly.ts",
        "src/platform/store.worker.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      // NOTE: the SQLite package posts only to its worker and its broadcast
      // channel, never to a window, so no post has a target origin to name.
      "files": ["packages/sqlite-wasm-effect/src/**/*.ts"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      // NOTE: Effect's Schema names its annotations interface after its
      // namespace, and the wire packing adds to it under the same names.
      "files": ["src/world/schema/wireNumber.ts"],
      "rules": {
        "no-shadow": ["error", { "allow": ["Annotations"] }]
      }
    },
    {
      // NOTE: the service worker runs outside the game and the Effect runtime.
      "files": ["src/platform/sw/worker.ts"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      // NOTE: these define the view size (constants, screen), do world math
      // (camera, geometry), or draw deliberately inside inLandscapeFrame
      // (screens, endView, bossView).
      "files": [
        "src/shared/constants.ts",
        "src/render/screen.ts",
        "src/render/camera.ts",
        "src/world/step/geometry.ts",
        "src/screens/game/overlay.ts",
        "src/features/end/endView.ts",
        "src/render/bossView.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // NOTE: tools and the build configs are host scripts: they wait on
      // browsers and child processes one at a time.
      "files": ["tools/**/*.ts", "vite.config.ts", "vitest.config.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // NOTE: the tools and the packages keep the game's bans that apply
      // outside update (AGENTS.md "Strictness"): time from Effect's Clock,
      // waits from Effect.sleep or a Schedule, requests through HttpClient,
      // and unions as Schema unions.
      "files": [
        "tools/**/*.ts",
        "packages/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Draw from a seeded generator, or Effect's Random."
          },
          {
            "object": "Date",
            "property": "now",
            "message": "Read the time from Effect's Clock (Clock.currentTimeMillis)."
          },
          {
            "object": "Data",
            "property": "taggedEnum",
            "message": "Use a Schema union (Schema.TaggedUnion) and its exhaustive match."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "Wait with Effect.sleep or a Schedule."
          },
          {
            "name": "setInterval",
            "message": "Repeat with a Schedule."
          },
          {
            "name": "fetch",
            "message": "Request through Effect's HttpClient."
          }
        ]
      }
    },
    {
      // NOTE: the audits' page functions run inside the browser page, where
      // Effect is not loaded, so its timers, fetch, clock, and randomness are
      // the page's own (.oxlintrc.effect.json has the same exception).
      "files": ["tools/*/inPage/*.ts"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      // NOTE: the code that runs every rendered frame compares references or
      // a few fields, never deep equality, and looks tables up by numbers or
      // objects, never a string key built for the lookup (AGENTS.md "Keep the
      // frame cheap").
      "files": [
        "src/render/**/*.ts",
        "src/screens/**/*.ts",
        "src/app/layers.ts",
        "src/app/frame.ts",
        "src/app/view.ts",
        "src/app/update/play.ts",
        "src/world/step/**/*.ts",
        "src/world/zombies/**/*.ts"
      ],
      "rules": {
        "munch/no-deep-equal-per-frame": "error",
        "munch/no-string-key-per-frame": "error"
      }
    },
    {
      // NOTE: the World, the input and update that feed its intent, the
      // features' rules update runs (the lessons, the bots), and the lens
      // that turns a stick onto the floor must give the same bits in Bun,
      // Node, Chrome, and workerd (AGENTS.md "Keep the game
      // deterministic"), so they take their transcendental math from
      // src/shared/detMath.ts (munch/stable-math). Tests read what the step
      // left, and a feature's drawing only draws, so they may use Math's
      // own.
      "files": [
        "src/world/**/*.ts",
        "src/shared/**/*.ts",
        "src/input/**/*.ts",
        "src/app/**/*.ts",
        "src/domain/**/*.ts",
        "src/features/**/*.ts",
        "src/render/lens.ts",
        "src/render/camera.ts"
      ],
      "rules": { "munch/stable-math": "error" }
    },
    {
      "files": [
        "src/**/__tests__/**/*.ts",
        "src/features/**/*View.ts",
        "src/features/**/*Art.ts"
      ],
      "rules": { "munch/stable-math": "off" }
    },
    {
      // NOTE: the World's per-tick rules and the per-frame drawing scan no
      // list inside a loop over another; a bounded list (at most 4 seats)
      // says its bound in a NOTE on the disable (AGENTS.md "Keep the frame
      // cheap").
      "files": [
        "src/world/step/**/*.ts",
        "src/world/zombies/**/*.ts",
        "src/world/waves/**/*.ts",
        "src/world/gear/**/*.ts",
        "src/world/party/**/*.ts",
        "src/world/feats/**/*.ts",
        "src/world/keys/**/*.ts",
        "src/render/**/*.ts"
      ],
      "rules": { "munch/no-nested-scan": "error" }
    },
    {
      // NOTE: the client hands stepWorld its World alone, never the whole
      // Model, whose copies past 128 fields cost about 17 times as much
      // (AGENTS.md "Keep the frame cheap"). The World's own folders step a
      // World already.
      "files": [
        "src/app/**/*.ts",
        "src/screens/**/*.ts",
        "src/features/**/*.ts",
        "src/domain/**/*.ts",
        "src/render/**/*.ts",
        "src/input/**/*.ts",
        "src/platform/**/*.ts",
        "src/ui/**/*.ts"
      ],
      "rules": { "munch/step-world-alone": "error" }
    },
    {
      // NOTE: tests may scan freely: they run once, not every frame.
      "files": ["src/**/*.test.ts", "src/**/*.fixture.ts"],
      "rules": {
        "munch/no-deep-equal-per-frame": "off",
        "munch/no-string-key-per-frame": "off",
        "munch/no-nested-scan": "off",
        "munch/step-world-alone": "off"
      }
    },
    {
      // NOTE: menuState derives which menu is up from these fields, so it is
      // the one place that reads them to decide (munch/no-menu-field). The
      // root's dialog views draw each dialog open on its own field.
      "files": [
        "src/app/menuState.ts",
        "src/app/dialogs.ts",
        "src/app/profileView.ts"
      ],
      "rules": { "munch/no-menu-field": "off" }
    },
    {
      // NOTE: the one key table, the one place that asks whether READY's
      // key is held to buy (munch/key-action-once).
      "files": ["src/input/keyActions.ts"],
      "rules": { "munch/key-action-once": "off" }
    },
    {
      // NOTE: a voxel slab's own axes run along the camera's up and toward
      // the lens, and a carved piece's faces point toward it; both still
      // stand through standingPointOf. The alignment
      // test reads a point back onto the screen with them
      // (munch/stand-through-space).
      "files": [
        "src/render/iso/voxelShape.ts",
        "src/render/iso/carvedMesh.ts",
        "src/render/__tests__/muzzleFlash.test.ts"
      ],
      "rules": { "munch/stand-through-space": "off" }
    },
    {
      // NOTE: tests and their shared setup run Effects with it.effect from
      // @effect/vitest, never by hand (munch/no-run-in-tests), and every
      // Story, Scene, and Play they make runs (munch/no-floating-story).
      // They drive the game through a Story or Scene over the root or a
      // child component, not pureApp's update, view, or init
      // (munch/no-plain-story).
      "files": [
        "**/*.test.ts",
        "**/test/**/*.ts",
        "**/*.fixture.ts",
        "**/*.setup.ts",
        "**/{testing,Testing,roomTesting}.ts",
        "src/test/vitest-setup.ts",
        "src/test/testPng.ts"
      ],
      "rules": {
        "munch/no-run-in-tests": "error",
        "munch/no-floating-story": "error",
        "munch/no-plain-story": "error"
      }
    },
    // NOTE: the files allowed raw JSON.parse and JSON.stringify, each with
    // its reason. Everything else reads and writes JSON through a Schema.
    {
      // NOTE: tests write raw and malformed payloads to feed the decoders,
      // and compare plain values by their text.
      "files": ["**/*.test.ts"],
      "rules": { "munch/no-raw-json": "off" }
    },
    {
      // NOTE: writes the service worker's build id and precache list as
      // JavaScript literals into its source, not JSON to be read back.
      "files": ["src/platform/sw/precache.ts"],
      "rules": { "munch/no-raw-json": "off" }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "repos/",
    "**/*.d.ts",
    "**/*.config.js",
    "**/*.config.mjs"
  ]
}
