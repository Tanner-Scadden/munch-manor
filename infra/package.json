{
  "name": "munch-manor-infra",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "alchemy deploy",
    "plan": "alchemy plan",
    "destroy": "alchemy destroy",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint": "effect-tsgo tsrs --noEmit && effect-tsgo --tsrs-lint oxlint --report-unused-disable-directives-severity=error . && effect-tsgo --tsrs-lint oxlint --config .oxlintrc.effect.json --deny-warnings .",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/sql-d1": "4.0.7",
    "@effect/sql-sqlite-do": "4.1.0",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@effect/sql-sqlite-bun": "4.1.0",
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.0",
    "@types/bun": "1.4.4",
    "oxlint": "1.92.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  }
}
