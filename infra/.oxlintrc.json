{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // NOTE: the same baseline as the root .oxlintrc.json, without the Foldkit
  // and game rules, which are about the app.
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  // NOTE: the project's own rules (AGENTS.md "Code shape").
  "jsPlugins": ["../tools/lint/munchPlugin.ts"],
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "rules": {
    "import/no-cycle": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    // NOTE: a file past 1200 lines holds two jobs, as in the root config.
    "max-lines": ["error", { "max": 1200 }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "sort-imports": [
      "error",
      { "ignoreDeclarationSort": true, "ignoreCase": false }
    ],
    "typescript/array-type": ["error", { "default": "generic" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "curly": ["error", "all"],
    "eqeqeq": ["error", "always"],
    "no-shadow": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "munch/no-tag-chain": "error",
    "munch/no-extract-tag": "error",
    "munch/no-raw-json": "error",
    "munch/live-test-note": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-base-to-string": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/strict-boolean-expressions": "error"
  },
  "overrides": [
    {
      // NOTE: tests and their shared setup run Effects with it.effect from
      // @effect/vitest, never by hand (munch/no-run-in-tests).
      "files": ["**/*.test.ts", "worker/testing.ts"],
      "rules": { "munch/no-run-in-tests": "error" }
    },
    {
      // NOTE: a wrong non-null assertion in a test fails the test loudly.
      "files": ["**/*.test.ts"],
      "rules": { "typescript/no-non-null-assertion": "off" }
    },
    {
      // NOTE: tests write raw and malformed payloads to feed the Worker and
      // read its answers by their text. Everything else goes through a
      // Schema (munch/no-raw-json).
      "files": ["**/*.test.ts"],
      "rules": { "munch/no-raw-json": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", ".alchemy/", "**/*.d.ts"]
}
