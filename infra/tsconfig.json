{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "paths": {
      "effect": ["./node_modules/effect/dist/index"],
      "effect/*": ["./node_modules/effect/dist/*"]
