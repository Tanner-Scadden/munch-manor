    "../src/platform/playerProjection.ts",
    "../src/shared/journalData.ts",
    "../src/shared/missionData.ts",
    "../src/shared/dayStamp.ts",
    "../src/shared/masteryData.ts",
    "../src/shared/dareMarkData.ts",
    "../src/shared/proofData.ts",
    "../src/shared/rankCurve.ts",
    "../src/platform/recordingApi.ts",
