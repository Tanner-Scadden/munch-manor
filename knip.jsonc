// NOTE: knip fails an unused file, export, type, or dependency anywhere in
// the game, the packages, infra, and the tools (AGENTS.md "Code shape"). It
// runs in `bun run lint`. An entry is a file something outside the import
// graph starts: the page, a worker, a config, or a script run with
// `bun <file>`. A new script joins its workspace's `entry` list.
{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // NOTE: a stale entry or ignore fails too, so the config stays true.
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": [
        // NOTE: index.html loads src/entry.ts (knip's Vite plugin finds it).
        // vite.config.ts emits src/early.ts as its own chunk and bundles the
        // service worker from source.
        "src/early.ts",
        "src/sw/worker.ts",
        "tools/analytics/{report,smoke}.ts",
        "tools/balance/{nightly,simulate}.ts",
        "tools/determinism/{beforeAfter,build,cli,crossEngine,page,worker,worldWorker}.ts",
        "tools/mp-dev/{build,e2e,local,main,serve}.ts",
        "tools/sprites/build.ts",
        "tools/video/{audioPage,video}.ts",
      ],
      "project": [
        "src/**/*.{ts,css}",
        "tools/**/*.{ts,mjs}",
        "!tools/audit/**",
      ],
      // NOTE: vitest's default test glob would reach the vendored repos/.
      // These are the files vitest.config.ts runs.
      "vitest": {
        "config": ["vitest.config.ts"],
        "entry": [
          "src/**/*.test.ts",
          "tools/**/*.test.ts",
          "src/vitest-setup.ts",
          "src/atlasHtml.setup.ts",
        ],
      },
      "ignoreDependencies": [
        // NOTE: the compiler `effect-tsgo tsrs` runs, named only on the
        // command line.
        "tsrs",
        // NOTE: the Effect language service in tsconfig.base.json's plugins,
        // served by @effect/tsgo.
        "@effect/language-service",
        // NOTE: Foldkit's Vite plugin injects the devtools into the page.
        "@foldkit/devtools",
        // NOTE: tools/video borrows tools/audit's install (its tsconfig paths).
        "playwright-core",
      ],
      // NOTE: a script the atlas test spawns with `bun`, an entry above.
      "ignoreUnresolved": ["tools/sprites/build.ts"],
    },
    "packages/*": {
      "project": ["**/*.ts"],
    },
    "infra": {
      // NOTE: github.ts is its own Alchemy app, deployed by hand.
      "entry": ["alchemy.run.ts", "github.ts", "worker/main.ts"],
      "project": ["**/*.ts"],
      // NOTE: the compiler `effect-tsgo tsrs` runs.
      "ignoreDependencies": ["tsrs"],
    },
    "tools/audit": {
      "entry": [
        "{beacon-check,closes,coop,icons,live-check,mp,offline,og,perf-check,perf,profile,profileClicks,save,splash,sqlite,sync,taps,twoThumbs}.ts",
        "shots*.ts",
        "harness/entry.ts",
        "harness/vite.config.ts",
      ],
      "project": ["**/*.ts"],
    },
  }
}
